{
  "name": "visual-stack",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build:esm": "bun build ./src/index.ts --outdir ./dist --format esm --target browser --minify --sourcemap --external d3",
    "build:umd": "bun build ./src/index.ts --outdir ./dist --format umd --target browser --naming visual-stack.umd.js --global-name VisualStack --minify --sourcemap --external d3",
    "build": "bun run build:esm && bun run build:umd",
    "test": "bun test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "@types/bun": "latest"
  },
  "private": true
}
